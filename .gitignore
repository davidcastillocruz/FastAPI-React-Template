# Alembic
# ---------------------------------------------------------------------------
# Track env.py and script.py.mako, but ignore generated migrations.
backend/src/database/migrations/versions/*.py

# Keep the versions folder in the repo even when it is empty.
!backend/src/database/migrations/versions/.gitkeep

